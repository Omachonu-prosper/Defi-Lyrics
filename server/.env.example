# Genius API token (https://genius.com/api-clients)
GENIUS_API_ACCESS_TOKEN=

# OpenAI
OPENAI_API_KEY=
# Optional, defaults to gpt-4.1-mini
OPENAI_MODEL=

# MongoDB. Optional, defaults to mongodb://localhost:27017 and defi_lyrics
MONGO_URI=
MONGO_DB_NAME=

# Definition quality gate. Optional, defaults to 0.8 and 2
CONFIDENCE_THRESHOLD=
MAX_REFINEMENTS=

# Optional, defaults to INFO. DEBUG also logs the reviewer's critiques
LOG_LEVEL=
